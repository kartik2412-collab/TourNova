# ============================================================
# TourNova — Environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. Only this example file is versioned.
# ============================================================

# --- Database (PostgreSQL) ---
# Connection string for the Drizzle ORM client and migrations.
# Local example: postgres://postgres:password@localhost:5432/tournova
# Neon/serverless example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/tournova?sslmode=require
DATABASE_URL="postgres://postgres:password@localhost:5432/tournova"

# --- Application ---
# Base URL of the app. Used for absolute links / canonical URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Authentication ---
# Secret used to sign session/JWT tokens. Generate a long random string.
# e.g. `openssl rand -base64 32`
AUTH_SECRET="change-me-to-a-long-random-secret"
# Session lifetime in days (1–365, default 30 days).
AUTH_SESSION_TTL_DAYS="30"
# Password used by `npm run db:create-admin` when --password= is not given.
# AUTH_ADMIN_PASSWORD=""

# --- Data freshness thresholds (minutes) ---
# How long verified data may be presented as current before it is flagged
# stale / expired. Tune per deployment without a code change.
# FRESHNESS_CROWD_MINUTES="30"
# FRESHNESS_PRICE_HOURS="1440"
# FRESHNESS_HOURS_HOURS="10080"
# FRESHNESS_BUSINESS_DAYS="43200"
# FRESHNESS_DEFAULT_DAYS="43200"

# --- Geo providers (disabled until configured) ---
# Coordinates are candidate-only and reviewed by a human. Remote geocoding
# providers are documented in src/lib/geo/providers.ts and stay OFF until the
# operator supplies real configuration below. Never commit real credentials.
# NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
# NOMINATIM_REFERER="https://your-app.example.test"
# NOMINATIM_EMAIL="your-contact@example.com"
# GOOGLE_MAPS_API_KEY=""
# MAPBOX_ACCESS_TOKEN=""

# --- Map provider (future) ---
# Provider is abstracted so it can be swapped. Values are placeholders.
# NEXT_PUBLIC_MAP_PROVIDER="openstreetmap"
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# --- AI (future) ---
# LLM provider key. Add only when implementing the AI assistant/RAG.
# AI_API_KEY=""
# AI_BASE_URL=""
